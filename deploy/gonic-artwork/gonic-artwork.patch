+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"go.senan.xyz/gonic/server/ctrlsubsonic/spec"
+)
+
+func writeArtwork(t *testing.T, dir, name string) {
+	t.Helper()
+	f, err := os.Create(filepath.Join(dir, name))
+	require.NoError(t, err)
+	require.NoError(t, png.Encode(f, image.NewNRGBA(image.Rect(0, 0, 600, 400))))
+	require.NoError(t, f.Close())
+}
+
+func TestAlbumArtworkFilesystem(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"z.png", "Front.PNG", "folder.png", "cover.png", "a.png"} {
+		writeArtwork(t, dir, name)
+	}
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "bad.png"), []byte("not an image"), 0600))
+	require.NoError(t, os.Mkdir(filepath.Join(dir, "child"), 0700))
+	writeArtwork(t, filepath.Join(dir, "child"), "hidden.png")
+	require.NoError(t, os.Symlink(filepath.Join(dir, "a.png"), filepath.Join(dir, "link.png")))
+	root, err := os.OpenRoot(dir)
+	require.NoError(t, err)
+	defer root.Close()
+	entries, err := listAlbumArtworks(root)
+	require.NoError(t, err)
+	var names []string
+	for _, a := range entries {
+		names = append(names, a.Name)
+		require.NotEmpty(t, a.Version)
+		require.NotContains(t, a.ID, a.Name)
+	}
+	require.Equal(t, []string{"cover.png", "folder.png", "Front.PNG", "a.png", "z.png"}, names)
+	old := entries[0]
+	writeArtwork(t, dir, "cover.png")
+	entries, err = listAlbumArtworks(root)
+	require.NoError(t, err)
+	require.Equal(t, old.ID, entries[0].ID)
+	require.NotEqual(t, old.Version, entries[0].Version)
+	for i := 0; i < 70; i++ {
+		writeArtwork(t, dir, fmt.Sprintf("extra-%02d.png", i))
+	}
+	entries, err = listAlbumArtworks(root)
+	require.NoError(t, err)
+	require.Len(t, entries, 64)
+}
+
+func artworkRouter(t *testing.T, f *fixture) *Controller {
+	t.Helper()
+	c, err := New(f.dbc, nil, false, f.contr.musicPaths, "", "", nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil)
+	require.NoError(t, err)
+	return c
+}
+
+func artworkRequest(c http.Handler, path string, q url.Values) *httptest.ResponseRecorder {
+	rr := httptest.NewRecorder()
+	c.ServeHTTP(rr, httptest.NewRequest(http.MethodGet, path+"?"+q.Encode(), nil))
+	return rr
+}
+
+func TestAlbumArtworkHTTP(t *testing.T) {
+	f := newFixture(t)
+	c := artworkRouter(t, f)
+	dir := filepath.Join(f.albumEmpty.RootDir, f.albumEmpty.LeftPath, f.albumEmpty.RightPath)
+	require.NoError(t, os.MkdirAll(dir, 0700))
+	writeArtwork(t, dir, "cover.png")
+	q := url.Values{"f": {"json"}, "v": {"1.16.1"}, "c": {"test"}, "id": {f.albumEmpty.SID().String()}}
+	for _, p := range []string{"/getAlbumArtworks", "/getAlbumArtwork", "/getOpenSubsonicExtensions"} {
+		rr := artworkRequest(c, p, q)
+		require.Contains(t, rr.Body.String(), `"status":"failed"`)
+	}
+	q.Set("u", f.admin.Name)
+	q.Set("p", "wrong-password")
+	require.Contains(t, artworkRequest(c, "/getAlbumArtworks", q).Body.String(), `"status":"failed"`)
+	q.Set("p", f.admin.Password)
+	rr := artworkRequest(c, "/getAlbumArtworks", q)
+	var body struct {
+		Response spec.Response `json:"subsonic-response"`
+	}
+	require.NoError(t, json.Unmarshal(rr.Body.Bytes(), &body))
+	require.Equal(t, "ok", body.Response.Status)
+	require.Len(t, body.Response.AlbumArtworks.Artwork, 1)
+	id := body.Response.AlbumArtworks.Artwork[0].ID
+	q.Set("artworkId", id)
+	rr = artworkRequest(c, "/getAlbumArtwork", q)
+	require.Equal(t, "image/png", rr.Header().Get("Content-Type"))
+	require.Equal(t, "nosniff", rr.Header().Get("X-Content-Type-Options"))
+	cfg, _, err := image.DecodeConfig(bytes.NewReader(rr.Body.Bytes()))
+	require.NoError(t, err)
+	require.Equal(t, 600, cfg.Width)
+	q.Set("size", "300")
+	rr = artworkRequest(c, "/getAlbumArtwork", q)
+	cfg, _, err = image.DecodeConfig(bytes.NewReader(rr.Body.Bytes()))
+	require.NoError(t, err)
+	require.Equal(t, 300, cfg.Width)
+	require.Equal(t, 200, cfg.Height)
+	for _, bad := range []string{"../cover.png", "https://example.com/x", id + "x"} {
+		q.Set("artworkId", bad)
+		rr = artworkRequest(c, "/getAlbumArtwork", q)
+		require.Contains(t, rr.Body.String(), `"status":"failed"`)
+	}
+	q.Set("artworkId", id)
+	q.Set("size", "-1")
+	require.Contains(t, artworkRequest(c, "/getAlbumArtwork", q).Body.String(), `"status":"failed"`)
+	q.Del("size")
+	require.NoError(t, os.Remove(filepath.Join(dir, "cover.png")))
+	require.Contains(t, artworkRequest(c, "/getAlbumArtwork", q).Body.String(), `"code":70`)
+	q.Set("id", "al-9999999")
+	require.Contains(t, artworkRequest(c, "/getAlbumArtworks", q).Body.String(), `"code":70`)
+	q.Set("id", "tr-1")
+	require.Contains(t, artworkRequest(c, "/getAlbumArtworks", q).Body.String(), `"status":"failed"`)
+	rr = artworkRequest(c, "/getOpenSubsonicExtensions", q)
+	require.Contains(t, rr.Body.String(), `"name":"splayerAlbumArtworks","versions":[1]`)
+}
+
+func TestAlbumArtworkDirectoryContainment(t *testing.T) {
+	f := newFixture(t)
+	for _, path := range []string{"../../escape", "/outside"} {
+		f.albumEmpty.LeftPath = path
+		f.albumEmpty.RightPath = "album"
+		_, err := f.contr.openAlbumArtworkDirectory(&f.albumEmpty)
+		require.Error(t, err)
+	}
+	root := f.contr.musicPaths[0].Path
+	require.NoError(t, os.Symlink(t.TempDir(), filepath.Join(root, "linked")))
+	f.albumEmpty.RootDir = root
+	f.albumEmpty.LeftPath = ""
+	f.albumEmpty.RightPath = "linked"
+	_, err := f.contr.openAlbumArtworkDirectory(&f.albumEmpty)
+	require.Error(t, err)
+	f.albumEmpty.RootDir = t.TempDir()
+	f.albumEmpty.RightPath = "."
+	_, err = f.contr.openAlbumArtworkDirectory(&f.albumEmpty)
+	require.Error(t, err)
+}
+
+func TestAlbumArtworkSizeAndPixels(t *testing.T) {
+	dir := t.TempDir()
+	f, err := os.Create(filepath.Join(dir, "huge.png"))
+	require.NoError(t, err)
+	require.NoError(t, f.Truncate(maxAlbumArtworkBytes+1))
+	require.NoError(t, f.Close())
+	// PNG IHDR declares too many pixels: reject before attempting full allocation.
+	var b bytes.Buffer
+	require.NoError(t, png.Encode(&b, image.NewNRGBA(image.Rect(0, 0, 1, 1))))
+	data := b.Bytes()
+	data[16] = 0x7f
+	data[17] = 0xff
+	data[18] = 0xff
+	data[19] = 0xff
+	binary.BigEndian.PutUint32(data[29:33], crc32.ChecksumIEEE(data[12:29]))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "bomb.png"), data, 0600))
+	root, err := os.OpenRoot(dir)
+	require.NoError(t, err)
+	defer root.Close()
+	entries, err := listAlbumArtworks(root)
+	require.NoError(t, err)
+	require.Empty(t, entries)
+}
+
+func TestAlbumArtworkListingReadsHeadersOnly(t *testing.T) {
+	dir := t.TempDir()
+	writeArtwork(t, dir, "track.flac") // 即使内容像图片，音频扩展也不得读取。
+	var encoded bytes.Buffer
+	require.NoError(t, png.Encode(&encoded, image.NewNRGBA(image.Rect(0, 0, 10, 10))))
+	// IHDR 之后的数据损坏：枚举仅探测头部，实际图片请求必须完整校验。
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "header.png"), encoded.Bytes()[:33], 0600))
+	root, err := os.OpenRoot(dir)
+	require.NoError(t, err)
+	defer root.Close()
+	entries, err := listAlbumArtworks(root)
+	require.NoError(t, err)
+	require.Len(t, entries, 1)
+	require.Equal(t, "header.png", entries[0].Name)
+	_, _, _, _, err = readAlbumArtwork(root, "header.png")
+	require.Error(t, err)
+}
