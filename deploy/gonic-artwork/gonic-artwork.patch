diff --git a/server/ctrlsubsonic/handlers_album_artworks.go b/server/ctrlsubsonic/handlers_album_artworks.go
new file mode 100644
index 0000000..aa68992
--- /dev/null
+++ b/server/ctrlsubsonic/handlers_album_artworks.go
@@ -0,0 +1,328 @@
+package ctrlsubsonic
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"image"
+	_ "image/gif"
+	_ "image/jpeg"
+	"image/png"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/disintegration/imaging"
+	_ "golang.org/x/image/bmp"
+	_ "golang.org/x/image/webp"
+
+	"go.senan.xyz/gonic/db"
+	"go.senan.xyz/gonic/server/ctrlsubsonic/params"
+	"go.senan.xyz/gonic/server/ctrlsubsonic/spec"
+	"go.senan.xyz/gonic/server/ctrlsubsonic/specid"
+)
+
+const (
+	maxAlbumArtworks           = 64
+	maxAlbumArtworkBytes       = 32 << 20
+	maxAlbumArtworkPixels      = 40_000_000
+	maxAlbumArtworkHeaderBytes = 1 << 20
+)
+
+// 同时最多解码两张原图，限制并行缩略图请求的峰值内存。
+var albumArtworkDecodeSlots = make(chan struct{}, 2)
+
+// ServeGetAlbumArtworks 使用数据库目录与现有账号鉴权，不接收客户端路径。
+func (c *Controller) ServeGetAlbumArtworks(r *http.Request) *spec.Response {
+	dir, failure := c.albumArtworkDirectory(r)
+	if failure != nil {
+		return failure
+	}
+	defer dir.Close()
+	artworks, err := listAlbumArtworks(dir)
+	if err != nil {
+		return spec.NewError(0, "could not read album artworks")
+	}
+	sub := spec.NewResponse()
+	sub.AlbumArtworks = &spec.AlbumArtworks{Artwork: artworks}
+	return sub
+}
+
+func (c *Controller) albumArtworkDirectory(r *http.Request) (*os.Root, *spec.Response) {
+	p := r.Context().Value(CtxParams).(params.Params)
+	id, err := p.GetID("id")
+	if err != nil || id.Type != specid.Album || id.Value <= 0 {
+		return nil, spec.NewError(10, "please provide an album `id`")
+	}
+	var album db.Album
+	if err := c.dbc.First(&album, id.Value).Error; err != nil {
+		return nil, spec.NewError(70, "album not found")
+	}
+	dir, err := c.openAlbumArtworkDirectory(&album)
+	if err != nil {
+		return nil, spec.NewError(70, "album artwork directory unavailable")
+	}
+	return dir, nil
+}
+
+// openAlbumArtworkDirectory 在音乐根目录内打开专辑，拒绝各级符号链接。
+// os.Root 还可防止检查后替换链接造成目录逃逸。
+func (c *Controller) openAlbumArtworkDirectory(album *db.Album) (*os.Root, error) {
+	allowed := false
+	for _, music := range c.musicPaths {
+		if filepath.Clean(music.Path) == filepath.Clean(album.RootDir) {
+			allowed = true
+			break
+		}
+	}
+	if !allowed {
+		return nil, fmt.Errorf("album root is not a configured music root")
+	}
+	if filepath.IsAbs(album.LeftPath) || filepath.IsAbs(album.RightPath) {
+		return nil, fmt.Errorf("absolute album path")
+	}
+	rel := filepath.Join(album.LeftPath, album.RightPath)
+	if !filepath.IsLocal(rel) {
+		return nil, fmt.Errorf("album path escapes root")
+	}
+	info, err := os.Lstat(album.RootDir)
+	if err != nil || !info.IsDir() {
+		return nil, fmt.Errorf("invalid music root")
+	}
+	root, err := os.OpenRoot(album.RootDir)
+	if err != nil {
+		return nil, err
+	}
+	for _, part := range strings.Split(rel, string(filepath.Separator)) {
+		if part == "." {
+			continue
+		}
+		before, err := root.Lstat(part)
+		if err != nil || !before.IsDir() || before.Mode()&os.ModeSymlink != 0 {
+			root.Close()
+			return nil, fmt.Errorf("invalid album directory")
+		}
+		child, err := root.OpenRoot(part)
+		if err != nil {
+			root.Close()
+			return nil, err
+		}
+		opened, err := child.Stat(".")
+		root.Close()
+		if err != nil || !os.SameFile(before, opened) {
+			child.Close()
+			return nil, fmt.Errorf("album directory changed")
+		}
+		root = child
+	}
+	return root, nil
+}
+
+func artworkPriority(name string) int {
+	switch strings.ToLower(strings.TrimSuffix(name, filepath.Ext(name))) {
+	case "cover":
+		return 0
+	case "folder":
+		return 1
+	case "front":
+		return 2
+	}
+	return 3
+}
+
+func artworkID(name string) string {
+	sum := sha256.Sum256([]byte(name))
+	return hex.EncodeToString(sum[:])
+}
+
+func artworkVersion(info os.FileInfo) string {
+	return fmt.Sprintf("%x-%x", info.ModTime().UnixNano(), info.Size())
+}
+
+func listAlbumArtworks(dir *os.Root) ([]spec.AlbumArtwork, error) {
+	f, err := dir.Open(".")
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	entries, err := f.ReadDir(-1)
+	if err != nil {
+		return nil, err
+	}
+	slices.SortFunc(entries, func(a, b os.DirEntry) int {
+		if d := artworkPriority(a.Name()) - artworkPriority(b.Name()); d != 0 {
+			return d
+		}
+		if d := strings.Compare(strings.ToLower(a.Name()), strings.ToLower(b.Name())); d != 0 {
+			return d
+		}
+		return strings.Compare(a.Name(), b.Name())
+	})
+	artworks := make([]spec.AlbumArtwork, 0)
+	for _, entry := range entries {
+		if len(artworks) == maxAlbumArtworks {
+			break
+		}
+		if !entry.Type().IsRegular() || !supportedArtworkName(entry.Name()) {
+			continue
+		}
+		info, err := probeAlbumArtwork(dir, entry.Name())
+		if err != nil {
+			continue
+		}
+		artworks = append(artworks, spec.AlbumArtwork{ID: artworkID(entry.Name()), Name: entry.Name(), Version: artworkVersion(info)})
+	}
+	return artworks, nil
+}
+
+func supportedArtworkName(name string) bool {
+	switch strings.ToLower(filepath.Ext(name)) {
+	case ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp":
+		return true
+	}
+	return false
+}
+
+func openAlbumArtwork(dir *os.Root, name string) (*os.File, os.FileInfo, error) {
+	if filepath.Base(name) != name || !supportedArtworkName(name) {
+		return nil, nil, fmt.Errorf("invalid artwork name")
+	}
+	before, err := dir.Lstat(name)
+	if err != nil {
+		return nil, nil, err
+	}
+	if !before.Mode().IsRegular() || before.Size() > maxAlbumArtworkBytes {
+		return nil, nil, fmt.Errorf("invalid artwork file")
+	}
+	f, err := dir.Open(name)
+	if err != nil {
+		return nil, nil, err
+	}
+	info, err := f.Stat()
+	if err != nil || !info.Mode().IsRegular() || !os.SameFile(before, info) || info.Size() > maxAlbumArtworkBytes {
+		f.Close()
+		return nil, nil, fmt.Errorf("artwork changed")
+	}
+	return f, info, nil
+}
+
+func checkAlbumArtworkConfig(reader io.Reader) (string, error) {
+	cfg, format, err := image.DecodeConfig(reader)
+	if err != nil {
+		return "", err
+	}
+	switch format {
+	case "jpeg", "png", "gif", "bmp", "webp":
+	default:
+		return "", fmt.Errorf("unsupported artwork format")
+	}
+	if cfg.Width <= 0 || cfg.Height <= 0 || cfg.Width > maxAlbumArtworkPixels/cfg.Height {
+		return "", fmt.Errorf("artwork pixel limit")
+	}
+	return format, nil
+}
+
+// probeAlbumArtwork 仅扫描有界图片头；枚举不解码像素，也不读取音轨。
+func probeAlbumArtwork(dir *os.Root, name string) (os.FileInfo, error) {
+	f, info, err := openAlbumArtwork(dir, name)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	if _, err := checkAlbumArtworkConfig(io.LimitReader(f, maxAlbumArtworkHeaderBytes)); err != nil {
+		return nil, err
+	}
+	return info, nil
+}
+
+// readAlbumArtwork 仅完整解码被请求的图片，先在同一不可变字节快照上检查像素。
+func readAlbumArtwork(dir *os.Root, name string) ([]byte, image.Image, string, os.FileInfo, error) {
+	fail := func(err error) ([]byte, image.Image, string, os.FileInfo, error) { return nil, nil, "", nil, err }
+	f, info, err := openAlbumArtwork(dir, name)
+	if err != nil {
+		return fail(err)
+	}
+	defer f.Close()
+	data, err := io.ReadAll(io.LimitReader(f, maxAlbumArtworkBytes+1))
+	if err != nil {
+		return fail(err)
+	}
+	if len(data) > maxAlbumArtworkBytes {
+		return fail(fmt.Errorf("artwork too large"))
+	}
+	format, err := checkAlbumArtworkConfig(bytes.NewReader(data))
+	if err != nil {
+		return fail(err)
+	}
+	img, _, err := image.Decode(bytes.NewReader(data))
+	if err != nil {
+		return fail(err)
+	}
+	return data, img, format, info, nil
+}
+
+// ServeGetAlbumArtwork 重新枚举当前候选，仅允许服务端签发的不透明 ID。
+func (c *Controller) ServeGetAlbumArtwork(w http.ResponseWriter, r *http.Request) *spec.Response {
+	p := r.Context().Value(CtxParams).(params.Params)
+	id, err := p.Get("artworkId")
+	if err != nil || len(id) != 64 {
+		return spec.NewError(10, "please provide an `artworkId`")
+	}
+	size := 0
+	if raw, err := p.Get("size"); err == nil {
+		size, err = strconv.Atoi(raw)
+		if err != nil || size != 300 {
+			return spec.NewError(10, "size must be 300 or omitted")
+		}
+	}
+	dir, failure := c.albumArtworkDirectory(r)
+	if failure != nil {
+		return failure
+	}
+	defer dir.Close()
+	entries, err := listAlbumArtworks(dir)
+	if err != nil {
+		return spec.NewError(0, "could not read album artworks")
+	}
+	var selected *spec.AlbumArtwork
+	for i := range entries {
+		if entries[i].ID == id {
+			selected = &entries[i]
+			break
+		}
+	}
+	if selected == nil {
+		return spec.NewError(70, "album artwork not found")
+	}
+	select {
+	case albumArtworkDecodeSlots <- struct{}{}:
+		defer func() { <-albumArtworkDecodeSlots }()
+	case <-r.Context().Done():
+		return spec.NewError(0, "artwork request canceled")
+	}
+	data, img, format, info, err := readAlbumArtwork(dir, selected.Name)
+	if err != nil {
+		return spec.NewError(70, "album artwork unavailable")
+	}
+	mime := map[string]string{"jpeg": "image/jpeg", "png": "image/png", "gif": "image/gif", "bmp": "image/bmp", "webp": "image/webp"}[format]
+	if size > 0 {
+		var out bytes.Buffer
+		bound := min(size, max(img.Bounds().Dx(), img.Bounds().Dy()))
+		if err := png.Encode(&out, imaging.Fit(img, bound, bound, imaging.Lanczos)); err != nil {
+			return spec.NewError(0, "could not resize album artwork")
+		}
+		data = out.Bytes()
+		mime = "image/png"
+	}
+	w.Header().Set("Content-Type", mime)
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	w.Header().Set("Cache-Control", "private, no-cache")
+	w.Header().Set("ETag", fmt.Sprintf(`"%s-%s-%d"`, id, artworkVersion(info), size))
+	http.ServeContent(w, r, selected.Name, info.ModTime(), bytes.NewReader(data))
+	return nil
+}
